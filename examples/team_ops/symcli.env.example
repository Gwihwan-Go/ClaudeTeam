# Copy to ~/.claudeteam-teams/symcli.env and keep mode 600.
# Adjust the workdir, team roster and bot profile before running revival.
export CLAUDETEAM_WORKDIR="$HOME/Symcli"
export CLAUDETEAM_SESSION=symcli
export CLAUDETEAM_STATE_DIR="$CLAUDETEAM_WORKDIR/state"
export CLAUDETEAM_CONFIG_FILE="$CLAUDETEAM_WORKDIR/claudeteam.toml"
export LARK_CLI_PROFILE=symcli

# Configure FEISHU_APP_ID and FEISHU_APP_SECRET securely on this host.
# The group's chat_id and agent roster belong in claudeteam.toml.
