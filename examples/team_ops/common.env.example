# Copy to ~/.claudeteam-teams/common.env and keep mode 600.
# Activate the fork installation; adapt this path to your checkout.
source "$HOME/ClaudeTeam/.venv/bin/activate"

# Set CLAUDE_CODE_OAUTH_TOKEN securely before loading this file.
: "${CLAUDE_CODE_OAUTH_TOKEN:?Set your deployment OAuth token first}"
export CLAUDE_CODE_OAUTH_TOKEN
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN

# Optional proxy, if required by the deployment:
# export HTTPS_PROXY=http://127.0.0.1:7890
# export HTTP_PROXY="$HTTPS_PROXY"
# export https_proxy="$HTTPS_PROXY" http_proxy="$HTTP_PROXY"
